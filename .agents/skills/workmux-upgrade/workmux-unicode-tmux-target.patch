+    // === Unicode-preserving target name tests ===
+
+    #[test]
+    fn slugify_keep_unicode_matches_slugify_for_ascii() {
+        for input in [
+            "feature/auth",
+            "prj-4120/create-new-tags",
+            "My Cool Feature",
+            "Feature! @#$%",
+            "a__b--c",
+            "--leading-and-trailing--",
+        ] {
+            assert_eq!(slugify_keep_unicode(input), slugify(input), "input: {input}");
+        }
+    }
+
