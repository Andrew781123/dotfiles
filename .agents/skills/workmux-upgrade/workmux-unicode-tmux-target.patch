+/// Slugify a tmux target name while preserving Unicode letters/digits.
+///
+/// Unlike `slug::slugify`, this does NOT transliterate (so CJK stays CJK)
+/// and it does not lowercase non-ASCII. ASCII separators are collapsed to a
+/// single `-` exactly like `slug::slugify`, so ASCII branch names produce
+/// identical results.
+pub fn slugify_keep_unicode(name: &str) -> String {
+    let mut out = String::new();
+    for ch in name.to_lowercase().chars() {
+        if ch.is_alphanumeric() {
+            out.push(ch);
+        } else if !out.is_empty() && !out.ends_with('-') {
+            out.push('-');
+        }
+    }
+    while out.ends_with('-') {
+        out.pop();
+    }
+    out
+}
+
+/// Default tmux target name for a worktree: the branch name with only the
+/// tmux-unsafe separators collapsed, preserving Unicode (e.g. Chinese).
+pub fn derive_mux_target_name(branch_name: &str) -> Result<String> {
+    let name = slugify_keep_unicode(branch_name);
+    validate_handle(&name)?;
+    Ok(name)
+}
